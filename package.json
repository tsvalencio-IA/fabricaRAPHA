{
  "name": "smartsat-gps",
  "version": "6.1.1",
  "private": true,
  "type": "module",
  "description": "SMARTSAT RASTREADORES: frontend React com BFF seguro para Traccar 6.14, câmera ao vivo e identificação de motoristas.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "check:server": "node --check server.js",
    "lint": "eslint .",
    "test": "eslint . && node --test tests/map-position.test.mjs && node --check server.js && vite build && node tests/run-integration.mjs",
    "test:unit": "node --test tests/map-position.test.mjs",
    "test:integration": "node tests/run-integration.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "hls.js": "^1.7.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
